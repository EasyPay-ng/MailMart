<script>
function toggleMobileMenu(){
    document.getElementById("mobileNav").classList.toggle("active");
}

function closeMobileMenu(){
    document.getElementById("mobileNav").classList.remove("active");
}

const scrollTop=document.getElementById("scrollTop");

window.addEventListener("scroll",()=>{
    if(window.scrollY>500){
        scrollTop.classList.add("show");
    }else{
        scrollTop.classList.remove("show");
    }
});

const observer=new IntersectionObserver(entries=>{
    entries.forEach(entry=>{
        if(entry.isIntersecting){
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
        }
    });
},{threshold:.1});

document.querySelectorAll(".reveal").forEach(element=>{
    observer.observe(element);
});

window.addEventListener("resize",()=>{
    if(window.innerWidth>900){
        document.getElementById("mobileNav").classList.remove("active");
    }
});

const hero=document.querySelector(".hero");
const icons=document.querySelectorAll(".orbit-icon");

if(hero && window.innerWidth>700){

    hero.addEventListener("mousemove",event=>{

        const rect=hero.getBoundingClientRect();

        const x=(event.clientX-rect.left)/rect.width-.5;
        const y=(event.clientY-rect.top)/rect.height-.5;

        icons.forEach((icon,index)=>{

            const strength=(index+1)*1.5;

            icon.style.marginLeft=`${x*strength}px`;
            icon.style.marginTop=`${y*strength}px`;

        });

    });

    hero.addEventListener("mouseleave",()=>{

        icons.forEach(icon=>{
            icon.style.marginLeft="";
            icon.style.marginTop="";
        });

    });
}

document.querySelectorAll(".particle").forEach((particle,index)=>{
    particle.style.animationDelay=`${index*1.3}s`;
});
</script>

</body>
